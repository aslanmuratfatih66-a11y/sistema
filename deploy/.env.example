# /opt/sistema/.env — настройки сервера «Система».
# Права: владелец root, группа sistema, режим 0640. Этот файл НЕ коммитить с реальными значениями.
# После изменения: sudo systemctl restart sistema

# --- Этап 0 ---

# Адрес HTTP. Оставьте 127.0.0.1 — наружу сервис выходит только через reverse-proxy с HTTPS.
SISTEMA_ADDR=127.0.0.1:8087

# Каталог данных (БД, фото, бэкапы). Должен совпадать с ReadWritePaths в sistema.service.
SISTEMA_DATA_DIR=/opt/sistema/data

# Уровень лога: debug | info | warn | error
SISTEMA_LOG_LEVEL=info

# Формат лога: json | text (пишется в journald: journalctl -u sistema)
SISTEMA_LOG_FORMAT=json

# Как часто писать в лог потребление памяти (5m, 15m, 1h; 0 — выключить)
SISTEMA_MEM_LOG_INTERVAL=15m

# Лимит размера тела запроса, байт
SISTEMA_MAX_BODY_BYTES=1048576

# --- Будущие ключи (этап 6). Пока не используются, оставьте пустыми. ---
# Значения положить только сюда, на сервер. Никогда в репозиторий.

# этап 6: ключ ИИ-провайдера
SISTEMA_AI_API_KEY=
# этап 6: модель ИИ по умолчанию
SISTEMA_AI_MODEL=
