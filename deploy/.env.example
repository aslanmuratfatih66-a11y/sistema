# /opt/sistema/.env — настройки сервера «Система».
# Права: владелец root, группа sistema, режим 0640. Этот файл НЕ коммитить с реальными значениями.
# После изменения: sudo systemctl restart sistema
# Пустое значение = значение по умолчанию.

# --- Сеть ---

# Адрес HTTP. Оставьте 127.0.0.1 — наружу сервис выходит только через reverse-proxy с HTTPS (deploy/https.md).
SISTEMA_ADDR=127.0.0.1:8087

# 1 — сервер стоит за Caddy/nginx: IP клиента берётся из X-Forwarded-For (нужно для лимитов входа).
# 0 — прямой доступ (без прокси). За прокси ОБЯЗАТЕЛЬНО 1, без прокси ОБЯЗАТЕЛЬНО 0 (иначе IP подделывается).
SISTEMA_TRUST_PROXY=1

# --- Данные ---

# Каталог данных: БД sistema.db и фото (photos/). Должен быть в ReadWritePaths в sistema.service.
SISTEMA_DATA_DIR=/opt/sistema/data

# Каталог бэкапов: <dir>/<yyyy-mm-dd>/sistema.db и <dir>/photos (зеркало фото).
# По умолчанию /opt/sistema/backups. Другой диск — поменяйте здесь И в ReadWritePaths юнита.
SISTEMA_BACKUP_DIR=/opt/sistema/backups

# Сколько дней хранить ежедневные бэкапы БД (>= 1)
SISTEMA_BACKUP_KEEP_DAYS=14

# --- Лимиты ---

# Лимит тела запроса (пачка синхронизации), байт. По умолчанию 4 МиБ.
SISTEMA_MAX_BODY_BYTES=4194304

# Лимит загрузки одного фото, байт. По умолчанию 20 МиБ.
SISTEMA_MAX_PHOTO_BYTES=20971520

# --- Логи ---

# Уровень лога: debug | info | warn | error
SISTEMA_LOG_LEVEL=info

# Формат лога: json | text (пишется в journald: journalctl -u sistema)
SISTEMA_LOG_FORMAT=json

# Как часто писать в лог потребление памяти (5m, 15m, 1h; 0 — выключить)
SISTEMA_MEM_LOG_INTERVAL=15m

# --- Фоновые задачи ---

# Источник курсов валют. Пусто — источник по умолчанию.
SISTEMA_FX_URL=

# --- Будущие ключи (этап 6). Пока не используются, оставьте пустыми. ---
# Значения положить только сюда, на сервер. Никогда в репозиторий.

# этап 6: ключ ИИ-провайдера
SISTEMA_AI_API_KEY=
# этап 6: модель ИИ по умолчанию
SISTEMA_AI_MODEL=
